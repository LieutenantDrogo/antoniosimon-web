---
import imagesManifest from '../data/images.json';

type Slot = keyof typeof imagesManifest;

interface Props {
  slot: Slot;
}
const { slot } = Astro.props;
const img = imagesManifest[slot];
---
<div class="env">
  <div class="amb" style={`background-image:url('${img.ambient}')`}></div>
  <div class="scrim"></div>
  <picture>
    <source media="(max-width:820px)" srcset={img.mobile} />
    <img
      class="sharp"
      src={img.desktop}
      alt={img.alt}
      style={'filter' in img ? `filter:${img.filter}` : undefined}
    />
  </picture>
</div>
