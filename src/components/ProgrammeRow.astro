---
/**
 * One row of a document page. Used by Programmes (title + subtitle + desc + meta)
 * and Research (code + title + desc + meta) — same visual grammar, different fields.
 */
interface Props {
  code?: string;
  title: string;
  subtitle?: string;
  desc: string;
  meta?: string;
  url?: string;
  urlLabel?: string;
  descClass?: string;
  /** 2 for a top-level list (Programmes, Research); 3 inside a section that
      already has its own h2 (the recordings list on Listen). */
  level?: 2 | 3;
}
const { code, title, subtitle, desc, meta, url, urlLabel, descClass = 'desc', level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<article class="prog">
  {code && <p class="prog-code">{code}</p>}
  <Heading class="prog-title">{title}</Heading>
  {subtitle && <p class="prog-sub">{subtitle}</p>}
  <p class={descClass}>{desc}</p>
  {meta && <p class="meta">{meta}</p>}
  {url && urlLabel && (
    <p class="prog-link">
      <a href={url} rel="noopener">{urlLabel} <span aria-hidden="true">↗</span></a>
    </p>
  )}
</article>
