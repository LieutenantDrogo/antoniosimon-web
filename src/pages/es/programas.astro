---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayHeading from '../../components/DisplayHeading.astro';
import ProgrammeRow from '../../components/ProgrammeRow.astro';

const lang = 'es';
const page = await getEntry('pages', 'programmes');
if (!page) throw new Error('Missing pages entry: programmes');
const programmes = (await getCollection('programmes')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  pageId="programmes"
  lang={lang}
  title="Programas — Antonio Simón"
  description={page.data.metaDescription[lang]}
>
  <section class="page">
    <div class="inner">
      <div class="eyebrow">{page.data.eyebrow[lang]}</div>
      <DisplayHeading text={page.data.display} />
      <p class="lede">{page.data.lede?.[lang]}</p>
      <div style="margin-top:3rem">
        {programmes.map((p) => (
          <ProgrammeRow
            title={p.data.title[lang]}
            desc={p.data.desc[lang]}
            meta={`${p.data.duration} · ${p.data.forces[lang]}`}
          />
        ))}
      </div>
      {page.data.notebox && (
        <div class="notebox small">{page.data.notebox[lang]}</div>
      )}
    </div>
  </section>
</BaseLayout>
