---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoEnv from '../../components/PhotoEnv.astro';
import DisplayHeading from '../../components/DisplayHeading.astro';

const lang = 'es';
const page = await getEntry('pages', 'manifesto');
if (!page) throw new Error('Missing pages entry: manifesto');
const manifestoEntry = await getEntry('manifesto', `manifesto.${lang}`);
if (!manifestoEntry) throw new Error('Missing manifesto entry: es');
const { Content } = await render(manifestoEntry);
---
<BaseLayout
  pageId="manifesto"
  lang={lang}
  title="Manifiesto — Antonio Simón"
  description={page.data.metaDescription[lang]}
>
  <section class="page has-photo">
    <PhotoEnv slot="manifesto" />
    <div class="inner">
      <div class="content">
        <div class="eyebrow">{page.data.eyebrow[lang]}</div>
        <DisplayHeading text={page.data.display} italic={page.data.displayItalic} />
        <div class="manifesto-body">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
