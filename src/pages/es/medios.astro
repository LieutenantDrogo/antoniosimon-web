---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayHeading from '../../components/DisplayHeading.astro';
import VideoPoster from '../../components/VideoPoster.astro';
import ProgrammeRow from '../../components/ProgrammeRow.astro';

const lang = 'es';
const page = await getEntry('pages', 'media');
if (!page) throw new Error('Missing pages entry: media');
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const recordings = (await getCollection('recordings')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  pageId="media"
  lang={lang}
  title="Medios — Antonio Simón"
  description={page.data.metaDescription[lang]}
>
  <section class="page">
    <div class="inner">
      <div class="eyebrow">{page.data.eyebrow[lang]}</div>
      <DisplayHeading text={page.data.display} />
      <div class="vidgrid">
        {videos.map((v) => (
          <div class="vid">
            <div class="frame">
              <VideoPoster youtubeId={v.data.youtubeId} />
            </div>
            <p class="cap">
              {v.data.todo && v.data.caption ? (
                <span class="todo">{v.data.caption[lang]}</span>
              ) : (
                <>
                  <b>{v.data.captionBold?.[lang]}</b><br />
                  {v.data.captionRest?.[lang]}
                </>
              )}
              {' · '}
              <a href={`https://youtu.be/${v.data.youtubeId}`} target="_blank" rel="noopener">YouTube ↗</a>
            </p>
          </div>
        ))}
      </div>
      <div class="reclist">
        {page.data.reclistEyebrow && (
          <div class="eyebrow">{page.data.reclistEyebrow[lang]}</div>
        )}
        {recordings.map((r) => (
          <ProgrammeRow title={r.data.title[lang]} desc={r.data.desc[lang]} descClass="small dim" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
